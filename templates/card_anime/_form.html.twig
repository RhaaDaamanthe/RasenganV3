{# Formulaire commun à la création et à la modification d'une carte. #}
{{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'form-upload'}}) }}
    {{ form_errors(form) }}
    <div class="form-row">
        <div class="form-group">
            {{ form_label(form.nom) }}
            {{ form_widget(form.nom) }}
            {{ form_errors(form.nom) }}
        </div>
        <div class="form-group">
            {{ form_label(form.rarity) }}
            {{ form_widget(form.rarity) }}
            {{ form_errors(form.rarity) }}
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            {{ form_label(form.anime) }}
            {{ form_widget(form.anime) }}
            {{ form_errors(form.anime) }}
        </div>
        <div class="form-group">
            {{ form_label(form.imagePath) }}
            {{ form_widget(form.imagePath) }}
            {{ form_errors(form.imagePath) }}
            <small class="form-text text-muted">
                JPG, PNG ou WEBP, 20 Mo max.
                {%- if card_anime.imagePath %} Laisser vide pour garder l'image actuelle.{% endif %}
            </small>
            {% if card_anime.imagePath %}
                <img class="card-form-image-actuelle" src="{{ asset(card_anime.imagePath) }}" alt="Image actuelle de {{ card_anime.nom }}">
            {% endif %}
        </div>
    </div>
    <div class="form-group">
        {{ form_label(form.description) }}
        {{ form_widget(form.description, {'attr': {'rows': 3}}) }}
        {{ form_errors(form.description) }}
    </div>
    <button class="btn btn-primary" type="submit">{{ button_label|default('Créer') }}</button>
{{ form_end(form) }}
