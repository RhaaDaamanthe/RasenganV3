{% extends 'base.html.twig' %}

{% block title %}Modifier {{ card_anime.nom }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
{% endblock %}

{% block body %}
    <main class="admin-container">
        <div class="card-form-wrapper">
            <h1>Modifier la carte</h1>

            {{ include('card_anime/_form.html.twig', {'button_label': 'Modifier'}) }}

            <div class="card-form-footer">
                <a href="{{ path('app_card_anime_index') }}" class="btn btn-secondary">← Retour à la liste</a>
                {{ include('card_anime/_delete_form.html.twig') }}
            </div>
        </div>
    </main>
{% endblock %}
