{% extends 'base.html.twig' %}

{% block title %}Créer un film{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
{% endblock %}

{% block body %}
    <main class="admin-container">
        <div class="card-form-wrapper">
            <div class="simple-form-header">
                <span class="simple-form-icon">🎞️</span>
                <h1>Créer un nouveau film</h1>
                <p>Il pourra ensuite être associé à des cartes depuis la gestion des cartes de film.</p>
            </div>

            {{ form_start(form, {'attr': {'class': 'form-upload'}}) }}
                <div class="form-group">
                    {{ form_label(form.nom) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.surnoms) }}
                    {{ form_widget(form.surnoms) }}
                    {{ form_help(form.surnoms) }}
                </div>
                <button class="btn btn-primary" type="submit">Créer</button>
            {{ form_end(form) }}

            <div class="card-form-footer">
                <a href="{{ path('app_film_index') }}" class="btn btn-secondary">← Retour à la liste</a>
            </div>
        </div>
    </main>
{% endblock %}
