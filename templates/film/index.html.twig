{% extends 'base.html.twig' %}

{% block title %}Gérer les films{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
    <style>
        .flash-message {
            padding: 1rem;
            margin-bottom: 1rem;
            border-radius: 8px;
            font-weight: bold;
        }
        .flash-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .flash-error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
{% endblock %}

{% block body %}
<main>
    <div class="admin-container media-list-page">
        <div class="dashboard-hero">
            <h1>🎞️ Gérer les films</h1>
        </div>
        {% for message in app.flashes('success') %}
            <div class="flash-message flash-success">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash-message flash-error">
                {{ message }}
            </div>
        {% endfor %}

        <div class="actions-header">
            <a href="{{ path('app_film_new') }}" class="btn btn-action">
                Créer un nouveau film
            </a>
            
            <form method="get" action="{{ path('app_film_index') }}" class="search-container">
                <input type="text"
                       name="search"
                       value="{{ search }}"
                       placeholder="Rechercher un film..."
                       aria-label="Rechercher un film">
                <i class="fas fa-search"></i>
            </form>
        </div>

        <div class="card-grid">
            {% for film in films %}
                <div class="admin-card">
                    <div class="card-content">
                        <h3>{{ film.nom }}</h3>
                        <p><strong>ID:</strong> {{ film.id }}</p>
                    </div>

                    <div class="admin-card-actions">
                        <a href="{{ path('app_film_show', {'id': film.id}) }}" class="btn btn-info">Voir</a>
                        <a href="{{ path('app_film_edit', {'id': film.id}) }}" class="btn btn-warning">Modifier</a>
                        <form method="post"
                              action="{{ path('app_film_delete', {'id': film.id}) }}"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce film ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ film.id) }}">
                            <button type="submit" class="btn btn-danger">Supprimer</button>
                        </form>
                    </div>
                </div>
            {% else %}
                <p>
                    {% if search %}Aucun résultat ne correspond à "{{ search }}".{% else %}Aucun film trouvé.{% endif %}
                </p>
            {% endfor %}
        </div>

        {% if films.pageCount > 1 %}
            <div class="pagination-bar">
                {% if films.currentPageNumber > 1 %}
                    <a href="{{ path('app_film_index', {page: films.currentPageNumber - 1, search: search}) }}" class="btn btn-secondary">← Précédent</a>
                {% endif %}
                <span class="pagination-info">Page {{ films.currentPageNumber }} / {{ films.pageCount }}</span>
                {% if films.currentPageNumber < films.pageCount %}
                    <a href="{{ path('app_film_index', {page: films.currentPageNumber + 1, search: search}) }}" class="btn btn-secondary">Suivant →</a>
                {% endif %}
            </div>
        {% endif %}

        <div class="media-list-page-footer">
            <a href="{{ path('app_admin') }}" class="btn btn-secondary">← Retour au tableau de bord</a>
        </div>
    </div>
</main>
{% endblock %}