{% extends 'base.html.twig' %}

{% block title %}Modifier un film{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
{% endblock %}

{% block body %}
    <main class="admin-container">
        <div class="card-form-wrapper">
            <h1>Modifier le film "{{ film.nom }}"</h1>
            <p class="subtitle">Modifiez les informations de ce film.</p>
            <a href="{{ path('app_film_index') }}" class="btn btn-secondary top-action-link">Retour à la liste</a>
            
            {{ form_start(form, {'attr': {'class': 'form-upload'}}) }}
                <div class="form-group">
                    {{ form_label(form.nom) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                </div>
                <br>
                <button class="btn btn-primary" type="submit">Modifier</button>
            {{ form_end(form) }}

            <a href="{{ path('app_film_index') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
        </div>
    </main>
{% endblock %}