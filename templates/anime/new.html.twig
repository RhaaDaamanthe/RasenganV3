{% extends 'base.html.twig' %}

{% block title %}Créer un animé{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
    <style>
        .flash-message { padding: 1rem; margin-bottom: 1rem; border-radius: 8px; font-weight: bold; }
        .flash-success { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .flash-error { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }

        .simple-form-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .simple-form-header .simple-form-icon {
            font-size: 2.4em;
            display: block;
            margin-bottom: 6px;
        }

        .simple-form-header p {
            color: #777;
            margin: 6px 0 0;
            font-size: 0.95em;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="admin-container">
        <div class="card-form-wrapper">
            <div class="simple-form-header">
                <span class="simple-form-icon">🎬</span>
                <h1>Créer un nouvel animé</h1>
                <p>Il pourra ensuite être associé à des cartes depuis la gestion des cartes d'animé.</p>
            </div>

            {% for message in app.flashes('success') %}
                <div class="flash-message flash-success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="flash-message flash-error">{{ message }}</div>
            {% endfor %}

            {{ form_start(form, {'attr': {'class': 'form-upload'}}) }}
                <div class="form-group">
                    {{ form_label(form.nom) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                </div>
                <button class="btn btn-primary" type="submit">Créer</button>
            {{ form_end(form) }}

            <div class="card-form-footer">
                <a href="{{ path('app_anime_index') }}" class="btn btn-secondary">← Retour à la liste</a>
            </div>
        </div>
    </main>
{% endblock %}
