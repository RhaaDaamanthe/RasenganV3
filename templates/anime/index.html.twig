{% extends 'base.html.twig' %}

{% block title %}Gérer les animés{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
    <style>
        .flash-message {
            padding: 1rem;
            margin-bottom: 1rem;
            border-radius: 8px;
            font-weight: bold;
            text-align: center;
        }
        .flash-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .flash-error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
{% endblock %}

{% block body %}
<main>
    <div class="admin-container media-list-page">
        <div class="dashboard-hero">
            <h1>🎬 Gérer les animés</h1>
        </div>
        {% for message in app.flashes('success') %}
            <div class="flash-message flash-success">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash-message flash-error">
                {{ message }}
            </div>
        {% endfor %}

        <div class="actions-header">
            <a href="{{ path('app_anime_new') }}" class="btn btn-action">
                Créer un nouvel animé
            </a>
            
            <form method="get" action="{{ path('app_anime_index') }}" class="search-container">
                <input type="text"
                       name="search"
                       value="{{ search }}"
                       placeholder="Rechercher un animé..."
                       aria-label="Rechercher un animé">
                <i class="fas fa-search"></i>
            </form>
        </div>

        <div class="card-grid">
            {% for anime in animes %}
                <div class="admin-card">
                    <div class="card-content">
                        <h3>{{ anime.nom }}</h3>
                        <p><strong>ID :</strong> {{ anime.id }}</p>
                    </div>

                    <div class="admin-card-actions">
                        <a href="{{ path('app_anime_show', {'id': anime.id}) }}" class="btn btn-info">Voir</a>
                        <a href="{{ path('app_anime_edit', {'id': anime.id}) }}" class="btn btn-warning">Modifier</a>
                        <form method="post"
                              action="{{ path('app_anime_delete', {'id': anime.id}) }}"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet animé ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ anime.id) }}">
                            <button type="submit" class="btn btn-danger">Supprimer</button>
                        </form>
                    </div>
                </div>
            {% else %}
                <p>
                    {% if search %}Aucun résultat ne correspond à "{{ search }}".{% else %}Aucun animé trouvé.{% endif %}
                </p>
            {% endfor %}
        </div>

        {% if animes.pageCount > 1 %}
            <div class="pagination-bar">
                {% if animes.currentPageNumber > 1 %}
                    <a href="{{ path('app_anime_index', {page: animes.currentPageNumber - 1, search: search}) }}" class="btn btn-secondary">← Précédent</a>
                {% endif %}
                <span class="pagination-info">Page {{ animes.currentPageNumber }} / {{ animes.pageCount }}</span>
                {% if animes.currentPageNumber < animes.pageCount %}
                    <a href="{{ path('app_anime_index', {page: animes.currentPageNumber + 1, search: search}) }}" class="btn btn-secondary">Suivant →</a>
                {% endif %}
            </div>
        {% endif %}

        <div class="media-list-page-footer">
            <a href="{{ path('app_admin') }}" class="btn btn-secondary">← Retour au tableau de bord</a>
        </div>
    </div>
</main>
{% endblock %}