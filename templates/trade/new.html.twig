{% extends 'base.html.twig' %}

{% block title %}Proposer un échange à {{ recipient.pseudo }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
    <style>
        .trade-page {
            padding: 170px 20px 80px;
            min-height: calc(100vh - 100px);
            background: linear-gradient(180deg, #3a0705 0%, #1a0402 340px, #1a0402 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .trade-inner { width: 100%; max-width: 1600px; }
        .trade-columns { display: flex; gap: 24px; flex-wrap: wrap; }
        .trade-column { flex: 1 1 480px; min-width: 320px; }
        .trade-column h3 { color: #ff8c42; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
        .trade-column-count { color: #cdbfba; font-size: 0.8rem; margin-bottom: 12px; display: block; }
        .trade-filter-bar { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
        .trade-filter-bar input[type="text"] {
            flex: 1 1 180px;
            padding: 9px 14px;
            border-radius: 10px;
            border: 1px solid rgba(231, 109, 10, 0.35);
            background: #1e0403;
            color: #fff;
            font-family: inherit;
            font-size: 0.85rem;
        }
        .trade-filter-bar input[type="text"]::placeholder { color: #8a6f68; }
        .trade-filter-bar input[type="text"]:focus,
        .trade-filter-bar select:focus {
            outline: none;
            border-color: #ff8c42;
            box-shadow: 0 0 0 3px rgba(255, 140, 66, 0.2);
        }
        .trade-filter-bar select {
            flex: 0 1 160px;
            padding: 9px 12px;
            border-radius: 10px;
            border: 1px solid rgba(231, 109, 10, 0.35);
            background: #1e0403;
            color: #fff;
            font-family: inherit;
            font-size: 0.85rem;
            cursor: pointer;
        }
        .trade-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 12px; max-height: 60vh; overflow-y: auto; padding: 4px; }
        .trade-card-pick.filtered-out { display: none; }
        .trade-filter-empty { color: #8a6f68; font-size: 0.85rem; padding: 12px 4px; display: none; }
        .trade-card-pick {
            position: relative;
            background: linear-gradient(160deg, #4a0e0a 0%, #2e0503 100%);
            border: 2px solid rgba(231, 109, 10, 0.25);
            border-radius: 10px; padding: 8px; text-align: center; cursor: pointer; color: #fff;
            transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
            user-select: none;
        }
        .trade-card-pick:hover { border-color: rgba(255, 140, 66, 0.6); }
        .trade-card-pick img { width: 100%; border-radius: 6px; display: block; pointer-events: none; }
        .trade-card-pick .name { font-size: 0.75rem; margin-top: 6px; display: block; pointer-events: none; }
        .trade-card-pick .qty { font-size: 0.7rem; color: #cdbfba; pointer-events: none; }
        .trade-card-pick.selected {
            border-color: #ff8c42;
            box-shadow: 0 0 0 3px rgba(255, 140, 66, 0.35);
            transform: translateY(-4px);
        }
        .trade-card-pick .selected-badge {
            display: none;
            position: absolute; top: -8px; right: -8px;
            width: 24px; height: 24px; border-radius: 50%;
            background: #ff8c42; color: #fff; font-size: 0.8rem; font-weight: 700;
            align-items: center; justify-content: center;
            box-shadow: 0 2px 6px rgba(0,0,0,0.4);
        }
        .trade-card-pick.selected .selected-badge { display: flex; }
        .trade-card-pick .qty-picker {
            display: none;
            align-items: center; justify-content: center; gap: 6px;
            margin-top: 6px;
        }
        .trade-card-pick.selected .qty-picker { display: flex; }
        .trade-card-pick .qty-picker button {
            width: 22px; height: 22px; border-radius: 6px; border: 1px solid rgba(231,109,10,0.5);
            background: #1e0403; color: #fff; cursor: pointer; font-weight: 700; line-height: 1;
        }
        .trade-card-pick .qty-picker input {
            width: 34px; text-align: center; background: #1e0403; color: #fff;
            border: 1px solid rgba(231,109,10,0.4); border-radius: 6px; padding: 2px;
        }
        .trade-submit-bar {
            position: sticky;
            bottom: 0;
            margin-top: 24px;
            padding: 14px 0 18px;
            text-align: center;
            background: linear-gradient(180deg, rgba(26,4,2,0) 0%, #1a0402 35%);
        }
        .trade-summary { color: #cdbfba; margin-bottom: 12px; font-size: 0.9rem; }
        .trade-submit-bar button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            min-height: 48px;
            padding: 12px 32px;
            border-radius: 999px;
            border: none;
            background: #e76d0a;
            color: #fff;
            font-family: inherit;
            font-size: 1rem;
            line-height: 1.2;
            font-weight: 700;
            cursor: pointer;
        }
        .trade-submit-bar button:hover { background: #ff8c42; }
    </style>
{% endblock %}

{% block body %}
<main class="trade-page">
<div class="trade-inner">
    <div class="player-collection-title-wrap">
        <span class="title-flourish"></span>
        <h2 class="player-collection-title">
            {% if counterOf is defined %}
                Contre-offre à {{ recipient.pseudo }}
            {% else %}
                Proposer un échange à {{ recipient.pseudo }}
            {% endif %}
        </h2>
        <span class="title-flourish"></span>
    </div>

    <p style="text-align:center; color:#cdbfba;">
        Cliquez sur les cartes pour les sélectionner (offertes à gauche, demandées à droite), ajustez la quantité si besoin, puis envoyez l'offre.
    </p>

    <form method="post" id="trade-form">
        <div class="trade-columns">
            <div class="trade-column">
                <h3>Vos cartes (offertes)</h3>
                <span class="trade-column-count" data-count-for="proposer_items[]">0 carte sélectionnée</span>
                <div class="trade-filter-bar">
                    <input type="text" class="trade-search" data-filter-target="proposer" placeholder="Rechercher une carte...">
                    <select class="trade-rarity-filter" data-filter-target="proposer">
                        <option value="">Toutes les raretés</option>
                        {% for rarity in rarities %}
                            <option value="{{ rarity.libelle }}">{{ rarity.libelle }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="trade-card-grid" data-grid="proposer">
                    {% for uc in myCardAnimes %}
                        <div class="trade-card-pick" data-input="proposer_items[]" data-value="anime:{{ uc.cardAnime.id }}" data-name="{{ uc.cardAnime.nom|lower }}" data-rarete="{{ uc.cardAnime.rarity.libelle }}">
                            <span class="selected-badge">✓</span>
                            <img src="{{ asset(uc.cardAnime.imagePath) }}" alt="{{ uc.cardAnime.nom }}">
                            <span class="name">{{ uc.cardAnime.nom }}</span>
                            <span class="qty">possédées : x{{ uc.quantity }}</span>
                            <span class="qty-picker">
                                <button type="button" class="qty-minus">−</button>
                                <input type="number" min="1" max="{{ uc.quantity }}" value="1">
                                <button type="button" class="qty-plus">+</button>
                            </span>
                        </div>
                    {% endfor %}
                    {% for uc in myCardFilms %}
                        <div class="trade-card-pick" data-input="proposer_items[]" data-value="film:{{ uc.cardFilm.id }}" data-name="{{ uc.cardFilm.nom|lower }}" data-rarete="{{ uc.cardFilm.rarity.libelle }}">
                            <span class="selected-badge">✓</span>
                            <img src="{{ asset(uc.cardFilm.imagePath) }}" alt="{{ uc.cardFilm.nom }}">
                            <span class="name">{{ uc.cardFilm.nom }}</span>
                            <span class="qty">possédées : x{{ uc.quantity }}</span>
                            <span class="qty-picker">
                                <button type="button" class="qty-minus">−</button>
                                <input type="number" min="1" max="{{ uc.quantity }}" value="1">
                                <button type="button" class="qty-plus">+</button>
                            </span>
                        </div>
                    {% endfor %}
                </div>
                <p class="trade-filter-empty" data-empty-for="proposer">Aucune carte ne correspond à votre recherche.</p>
            </div>

            <div class="trade-column">
                <h3>Cartes de {{ recipient.pseudo }} (demandées)</h3>
                <span class="trade-column-count" data-count-for="recipient_items[]">0 carte sélectionnée</span>
                <div class="trade-filter-bar">
                    <input type="text" class="trade-search" data-filter-target="recipient" placeholder="Rechercher une carte...">
                    <select class="trade-rarity-filter" data-filter-target="recipient">
                        <option value="">Toutes les raretés</option>
                        {% for rarity in rarities %}
                            <option value="{{ rarity.libelle }}">{{ rarity.libelle }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="trade-card-grid" data-grid="recipient">
                    {% for uc in theirCardAnimes %}
                        <div class="trade-card-pick" data-input="recipient_items[]" data-value="anime:{{ uc.cardAnime.id }}" data-name="{{ uc.cardAnime.nom|lower }}" data-rarete="{{ uc.cardAnime.rarity.libelle }}">
                            <span class="selected-badge">✓</span>
                            <img src="{{ asset(uc.cardAnime.imagePath) }}" alt="{{ uc.cardAnime.nom }}">
                            <span class="name">{{ uc.cardAnime.nom }}</span>
                            <span class="qty">possédées : x{{ uc.quantity }}</span>
                            <span class="qty-picker">
                                <button type="button" class="qty-minus">−</button>
                                <input type="number" min="1" max="{{ uc.quantity }}" value="1">
                                <button type="button" class="qty-plus">+</button>
                            </span>
                        </div>
                    {% endfor %}
                    {% for uc in theirCardFilms %}
                        <div class="trade-card-pick" data-input="recipient_items[]" data-value="film:{{ uc.cardFilm.id }}" data-name="{{ uc.cardFilm.nom|lower }}" data-rarete="{{ uc.cardFilm.rarity.libelle }}">
                            <span class="selected-badge">✓</span>
                            <img src="{{ asset(uc.cardFilm.imagePath) }}" alt="{{ uc.cardFilm.nom }}">
                            <span class="name">{{ uc.cardFilm.nom }}</span>
                            <span class="qty">possédées : x{{ uc.quantity }}</span>
                            <span class="qty-picker">
                                <button type="button" class="qty-minus">−</button>
                                <input type="number" min="1" max="{{ uc.quantity }}" value="1">
                                <button type="button" class="qty-plus">+</button>
                            </span>
                        </div>
                    {% endfor %}
                </div>
                <p class="trade-filter-empty" data-empty-for="recipient">Aucune carte ne correspond à votre recherche.</p>
            </div>
        </div>

        <div class="trade-submit-bar">
            <p class="trade-summary" id="trade-summary">Sélectionnez au moins une carte de chaque côté.</p>
            <button type="submit">
                {% if counterOf is defined %}Envoyer la contre-offre{% else %}Envoyer l'offre{% endif %}
            </button>
        </div>
    </form>
</div>
</main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var picks = document.querySelectorAll('.trade-card-pick');
            var summary = document.getElementById('trade-summary');
            var counts = document.querySelectorAll('.trade-column-count');

            function updateSummary() {
                var proposerCount = document.querySelectorAll('.trade-card-pick.selected[data-input="proposer_items[]"]').length;
                var recipientCount = document.querySelectorAll('.trade-card-pick.selected[data-input="recipient_items[]"]').length;

                counts.forEach(function (el) {
                    var count = el.dataset.countFor === 'proposer_items[]' ? proposerCount : recipientCount;
                    el.textContent = count + (count > 1 ? ' cartes sélectionnées' : ' carte sélectionnée');
                });

                if (proposerCount > 0 && recipientCount > 0) {
                    summary.textContent = proposerCount + ' carte(s) offerte(s) contre ' + recipientCount + ' carte(s) demandée(s).';
                } else {
                    summary.textContent = 'Sélectionnez au moins une carte de chaque côté.';
                }
            }

            picks.forEach(function (pick) {
                var qtyInput = pick.querySelector('.qty-picker input');
                var qtyMinus = pick.querySelector('.qty-minus');
                var qtyPlus = pick.querySelector('.qty-plus');

                pick.addEventListener('click', function () {
                    pick.classList.toggle('selected');
                    updateSummary();
                });

                [qtyInput, qtyMinus, qtyPlus].forEach(function (el) {
                    el.addEventListener('click', function (e) { e.stopPropagation(); });
                });

                qtyMinus.addEventListener('click', function () {
                    var val = Math.max(1, parseInt(qtyInput.value || '1', 10) - 1);
                    qtyInput.value = val;
                });

                qtyPlus.addEventListener('click', function () {
                    var max = parseInt(qtyInput.max || '1', 10);
                    var val = Math.min(max, parseInt(qtyInput.value || '1', 10) + 1);
                    qtyInput.value = val;
                });
            });

            document.getElementById('trade-form').addEventListener('submit', function (e) {
                var form = e.target;
                var proposerCount = 0;
                var recipientCount = 0;

                form.querySelectorAll('input.trade-hidden-item').forEach(function (el) { el.remove(); });

                document.querySelectorAll('.trade-card-pick.selected').forEach(function (pick) {
                    var hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.className = 'trade-hidden-item';
                    hidden.name = pick.dataset.input;
                    var qty = pick.querySelector('.qty-picker input').value || 1;
                    hidden.value = pick.dataset.value + ':' + qty;
                    form.appendChild(hidden);

                    if (pick.dataset.input === 'proposer_items[]') proposerCount++;
                    else recipientCount++;
                });

                if (proposerCount === 0 || recipientCount === 0) {
                    e.preventDefault();
                    alert("Sélectionnez au moins une carte de chaque côté avant d'envoyer l'offre.");
                }
            });

            updateSummary();

            // Recherche + filtre par rareté (par colonne), sans affecter la sélection déjà faite.
            document.querySelectorAll('[data-grid]').forEach(function (grid) {
                var target = grid.dataset.grid;
                var searchInput = document.querySelector('.trade-search[data-filter-target="' + target + '"]');
                var raritySelect = document.querySelector('.trade-rarity-filter[data-filter-target="' + target + '"]');
                var emptyMsg = document.querySelector('.trade-filter-empty[data-empty-for="' + target + '"]');
                var cards = grid.querySelectorAll('.trade-card-pick');

                function applyFilter() {
                    var query = (searchInput.value || '').trim().toLowerCase();
                    var rarity = raritySelect.value;
                    var visibleCount = 0;

                    cards.forEach(function (card) {
                        var matchesName = !query || card.dataset.name.indexOf(query) !== -1;
                        var matchesRarity = !rarity || card.dataset.rarete === rarity;
                        var visible = matchesName && matchesRarity;

                        card.classList.toggle('filtered-out', !visible);
                        if (visible) visibleCount++;
                    });

                    emptyMsg.style.display = visibleCount === 0 ? 'block' : 'none';
                }

                searchInput.addEventListener('input', applyFilter);
                raritySelect.addEventListener('change', applyFilter);
            });
        })();
    </script>
{% endblock %}
