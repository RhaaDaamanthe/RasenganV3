{% extends 'base.html.twig' %}

{% block title %}Collection de {{ user.pseudo }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
    <link rel="stylesheet" href="{{ asset('css/profil.css') }}">
{% endblock %}

{% block body %}
<main class="main-collec-responsive">

    <div class="player-collection-title-wrap">
        <span class="title-flourish"></span>
        <h2 id="Catalogue" class="player-collection-title">{{ user.titreCollection|default('Chez ' ~ user.pseudo) }}</h2>
        <span class="title-flourish"></span>
    </div>

    <!-- Onglets -->
    <div class="profile-tabs">
        <button type="button" class="profile-tab-btn active" data-tab="cartes">
            <span class="tab-btn-inner">🎴 Cartes</span>
        </button>
        <button type="button" class="profile-tab-btn" data-tab="badges">
            <span class="tab-btn-inner">🎖️ Badges</span>
        </button>
        <button type="button" class="profile-tab-btn" data-tab="stats">
            <span class="tab-btn-inner">📊 Stats</span>
        </button>
        <button type="button" class="profile-tab-btn" data-tab="vitrine">
            <span class="tab-btn-inner">🖼️ Vitrine</span>
            <span class="tab-soon">Bientôt</span>
        </button>
        <button type="button" class="profile-tab-btn" data-tab="wishlist">
            <span class="tab-btn-inner">💖 Wishlist</span>
        </button>
    </div>

    <div class="profile-tab-panel" data-tab-panel="cartes">

    <!-- Barre de recherche + filtres -->
    <div class="search-filters-container">
        <form method="get" action="" class="search-form">
            <div class="search-input-wrapper">
                <input 
                    type="text" 
                    name="search" 
                    id="searchbar" 
                    placeholder="Recherche un personnage, un animé, une série ou un film..." 
                    value="{{ search ?? '' }}"
                />
                <button type="submit" class="search-btn">
                    <i class="fas fa-search"></i>
                </button>
            </div>

            <div class="filters">
                <div class="filter-group">
                    <label for="sectionFilter">📚 Section</label>
                    <select name="section" id="sectionFilter" onchange="this.form.submit()">
                        <option value="">Toutes les sections</option>
                        <option value="anime" {% if selectedSection == 'anime' %}selected{% endif %}>Animés</option>
                        <option value="film" {% if selectedSection == 'film' %}selected{% endif %}>Films & séries</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label for="rarityFilter">🌟 Rareté</label>
                    <select name="rarity" id="rarityFilter" onchange="this.form.submit()">
                        <option value="">Toutes les raretés</option>
                        {% for rarity in rarities %}
                            <option value="{{ rarity.libelle }}" {% if selectedRarity == rarity.libelle %}selected{% endif %}>
                                {{ rarity.libelle }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {% if search or selectedRarity or selectedSection %}
                    <a href="{{ path(app.request.attributes.get('_route'), {'id': user.id}) }}" class="reset-filters">
                        ✖ Réinitialiser
                    </a>
                {% endif %}
            </div>

            <!-- 🟣 Compteur stylé intégré -->
            <div class="player-stats-inline">
                <span class="player-cards">🍜 {{ user.getTotalCardAnimeCount }} cartes Anime</span>
                <span class="player-cards">🎬 {{ user.getTotalCardFilmCount }} cartes Film</span>
            </div>
        </form>
    </div>


    <!-- Pagination (haut) -->
    {% if totalPages > 1 %}
        <div class="pagination pagination-top">
            {% if currentPage > 1 %}
                <a href="?page={{ currentPage - 1 }}{% if search %}&search={{ search }}{% endif %}{% if selectedRarity %}&rarity={{ selectedRarity }}{% endif %}{% if selectedSection %}&section={{ selectedSection }}{% endif %}" class="pagination-btn prev">← Précédent</a>
            {% endif %}

            <div class="pagination-numbers">
                {% for i in 1..totalPages %}
                    {% if i == 1 or i == totalPages or (i >= currentPage - 2 and i <= currentPage + 2) %}
                        <a href="?page={{ i }}{% if search %}&search={{ search }}{% endif %}{% if selectedRarity %}&rarity={{ selectedRarity }}{% endif %}{% if selectedSection %}&section={{ selectedSection }}{% endif %}"
                           class="page-number {% if i == currentPage %}active{% endif %}">
                            {{ i }}
                        </a>
                    {% elseif i == currentPage - 3 or i == currentPage + 3 %}
                        <span class="pagination-dots">...</span>
                    {% endif %}
                {% endfor %}
            </div>

            {% if currentPage < totalPages %}
                <a href="?page={{ currentPage + 1 }}{% if search %}&search={{ search }}{% endif %}{% if selectedRarity %}&rarity={{ selectedRarity }}{% endif %}{% if selectedSection %}&section={{ selectedSection }}{% endif %}" class="pagination-btn next">Suivant →</a>
            {% endif %}
        </div>
    {% endif %}

    <!-- Catalogue -->
    <div class="catalogue2">
        {% if paginatedCards is empty %}
            <div class="no-results">
                <p>😔 Aucune carte trouvée avec ces critères.</p>
                {% if search or selectedRarity or selectedSection %}
                    <a href="{{ path(app.request.attributes.get('_route'), {'id': user.id}) }}">Réinitialiser les filtres</a>
                {% else %}
                    <p>{{ user.pseudo }} n'a aucune carte dans son inventaire.</p>
                {% endif %}
            </div>
        {% else %}
            {% for userCard in paginatedCards %}
                {% if userCard.cardAnime is defined and userCard.cardAnime is not null %}
                    {% set card = userCard.cardAnime %}
                    {% set section = 'anime' %}
                {% elseif userCard.cardFilm is defined and userCard.cardFilm is not null %}
                    {% set card = userCard.cardFilm %}
                    {% set section = 'film' %}
                {% else %}
                    {% set card = null %}
                {% endif %}

                {% if card is not null %}
                    <div class="card">
                        {% if card.imagePath %}
                            <img src="{{ asset(card.imagePath) }}" alt="{{ card.nom }}">
                        {% else %}
                            <img src="{{ asset('images/placeholder.png') }}" alt="{{ card.nom }}">
                        {% endif %}
                        <div class="card-content">
                            <h2 class="card-title">x{{ userCard.quantity }}</h2>
                            {% if card.description %}
                                <p>{{ card.description|raw }}</p>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        {% endif %}
    </div>

    <!-- Pagination (bas) -->
    {% if totalPages > 1 %}
        <div class="pagination pagination-bottom">
            {% if currentPage > 1 %}
                <a href="?page={{ currentPage - 1 }}{% if search %}&search={{ search }}{% endif %}{% if selectedRarity %}&rarity={{ selectedRarity }}{% endif %}{% if selectedSection %}&section={{ selectedSection }}{% endif %}" class="pagination-btn prev">← Précédent</a>
            {% endif %}

            <div class="pagination-numbers">
                {% for i in 1..totalPages %}
                    {% if i == 1 or i == totalPages or (i >= currentPage - 2 and i <= currentPage + 2) %}
                        <a href="?page={{ i }}{% if search %}&search={{ search }}{% endif %}{% if selectedRarity %}&rarity={{ selectedRarity }}{% endif %}{% if selectedSection %}&section={{ selectedSection }}{% endif %}" 
                           class="page-number {% if i == currentPage %}active{% endif %}">
                            {{ i }}
                        </a>
                    {% elseif i == currentPage - 3 or i == currentPage + 3 %}
                        <span class="pagination-dots">...</span>
                    {% endif %}
                {% endfor %}
            </div>

            {% if currentPage < totalPages %}
                <a href="?page={{ currentPage + 1 }}{% if search %}&search={{ search }}{% endif %}{% if selectedRarity %}&rarity={{ selectedRarity }}{% endif %}{% if selectedSection %}&section={{ selectedSection }}{% endif %}" class="pagination-btn next">Suivant →</a>
            {% endif %}
        </div>
    {% endif %}

    </div>

    <div class="profile-tab-panel" data-tab-panel="badges" hidden>
        <div class="badges-panel-light">
            <h3>
                🎖️ Badges de {{ user.pseudo }}
                {% if user.badges|length > 0 %}
                    <span class="badge-count">({{ user.badges|length }})</span>
                {% endif %}
            </h3>

            {% if user.badges|length > 0 %}
                <div class="badges-container">
                    {% for badge in user.badges %}
                        <div class="badge-wrapper" data-name="{{ badge.name }}">
                            <img src="{{ asset('images/badges/' ~ badge.icon) }}"
                                 alt="{{ badge.name }}"
                                 class="badge-icon rarity-{{ badge.rarity }}"
                                 loading="lazy">
                            <div class="badge-tooltip">
                                <strong>{{ badge.name }}</strong>
                                {% if badge.description %}
                                    <br><small>{{ badge.description }}</small>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p><em>{{ user.pseudo }} n'a débloqué aucun badge pour le moment.</em></p>
            {% endif %}
        </div>
    </div>

    <div class="profile-tab-panel" data-tab-panel="stats" hidden>
        <div class="badges-panel-light">
            <h3>📊 Statistiques de rareté — {{ user.pseudo }}</h3>

            {% if rarityStats.total > 0 %}
                <p class="stats-intro">
                    Répartition de {{ rarityStats.total }} carte{{ rarityStats.total > 1 ? 's' : '' }} (hors mythiques et évènements) comparée aux taux de drop réels.
                    <br><span class="stats-legend"><span class="lucky">▲ vert</span> = plus que la moyenne, <span class="unlucky">▼ rouge</span> = moins que la moyenne.</span>
                </p>
                <div class="rarity-stats-list">
                    {% for row in rarityStats.rarities %}
                        <div class="rarity-stats-row">
                            <div class="rarity-stats-head">
                                <span class="rarity-pill {{ row.slug }}">{{ row.label }}</span>
                                <span class="rarity-stats-meta">
                                    {{ row.owned }} carte{{ row.owned > 1 ? 's' : '' }} · {{ row.actualPercent|number_format(1) }}% obtenu (normal {{ row.expectedPercent|number_format(0) }}%)
                                </span>
                                <span class="rarity-stats-delta {{ row.delta >= 0 ? 'lucky' : 'unlucky' }}">
                                    {{ row.delta >= 0 ? '▲' : '▼' }} {{ row.delta >= 0 ? '+' : '' }}{{ row.delta|number_format(1) }}%
                                </span>
                            </div>
                            <div class="rarity-delta-track">
                                <span class="rarity-delta-baseline"></span>
                                <span class="rarity-delta-fill {{ row.delta >= 0 ? 'lucky' : 'unlucky' }}" style="width: {{ row.barWidth|number_format(2) }}%"></span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p><em>{{ user.pseudo }} n'a pas encore de cartes communes/rares/épiques/légendaires à analyser.</em></p>
            {% endif %}
        </div>
    </div>

    <div class="profile-tab-panel" data-tab-panel="vitrine" hidden>
        <div class="profile-tab-panel-soon">
            <span class="soon-icon">🖼️</span>
            <h3>Vitrine à venir</h3>
            <p>{{ user.pseudo }} pourra bientôt mettre en avant ses cartes préférées ici.</p>
        </div>
    </div>

    <div class="profile-tab-panel" data-tab-panel="wishlist" hidden>
        <div class="badges-panel-light">
            <h3>💖 Wishlist de {{ user.pseudo }}</h3>

            {% if (wishlistAnime|length + wishlistFilm|length) > 0 %}
                <div class="wishlist-grid">
                    {% for card in wishlistAnime %}
                        <div class="wishlist-card{% if isOwnProfile %} wishlist-remove-card{% endif %}">
                            {% if isOwnProfile %}
                                <button type="button"
                                        class="wishlist-btn active"
                                        data-id="{{ card.id }}"
                                        data-type="anime"
                                        data-csrf="{{ csrf_token('wishlist-toggle') }}"
                                        title="Retirer de ma wishlist">♥</button>
                            {% endif %}
                            {% if card.imagePath %}
                                <img src="{{ asset(card.imagePath) }}" alt="{{ card.nom }}">
                            {% else %}
                                <img src="{{ asset('images/placeholder.png') }}" alt="{{ card.nom }}">
                            {% endif %}
                            <p class="wishlist-card-name">{{ card.nom }}</p>
                        </div>
                    {% endfor %}
                    {% for card in wishlistFilm %}
                        <div class="wishlist-card{% if isOwnProfile %} wishlist-remove-card{% endif %}">
                            {% if isOwnProfile %}
                                <button type="button"
                                        class="wishlist-btn active"
                                        data-id="{{ card.id }}"
                                        data-type="film"
                                        data-csrf="{{ csrf_token('wishlist-toggle') }}"
                                        title="Retirer de ma wishlist">♥</button>
                            {% endif %}
                            {% if card.imagePath %}
                                <img src="{{ asset(card.imagePath) }}" alt="{{ card.nom }}">
                            {% else %}
                                <img src="{{ asset('images/placeholder.png') }}" alt="{{ card.nom }}">
                            {% endif %}
                            <p class="wishlist-card-name">{{ card.nom }}</p>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p><em>{{ user.pseudo }} n'a pas encore ajouté de carte à sa wishlist.</em></p>
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# PAS de filtre_cartes.js - tout est géré en PHP maintenant #}
    <script src="{{ asset('js/utilisateurs_cartes.js') }}"></script>
    <script src="{{ asset('js/wishlist_toggle.js') }}"></script>
    <script>
        document.querySelectorAll('.profile-tab-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var target = btn.dataset.tab;

                document.querySelectorAll('.profile-tab-btn').forEach(function (b) {
                    b.classList.toggle('active', b === btn);
                });

                document.querySelectorAll('.profile-tab-panel').forEach(function (panel) {
                    panel.hidden = panel.dataset.tabPanel !== target;
                });
            });
        });
    </script>
{% endblock %}