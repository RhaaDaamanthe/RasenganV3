{% extends 'base.html.twig' %}

{% block title %}Collection des joueurs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
    <style>
        .global-stats {
            text-align: center;
            margin: 20px auto 45px;
        }

        .global-stats-grid {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .global-stat-tile {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            min-width: 150px;
            padding: 22px 34px;
            border-radius: 16px;
            background: linear-gradient(160deg, #4a0e0a 0%, #2e0503 100%);
            border: 1px solid rgba(231, 109, 10, 0.25);
            border-top: 3px solid #e76d0a;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .global-stat-tile:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
        }

        .global-stat-icon {
            font-size: 1.6rem;
        }

        .global-stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: #ff8c42;
        }

        .global-stat-label {
            font-size: 0.85rem;
            color: #cdbfba;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .catalogue {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 28px;
            justify-content: center;
            padding: 20px 0 50px;
        }

        .player-card-link {
            display: block;
        }

        .modern-player-card {
            position: relative;
            background: linear-gradient(160deg, #4a0e0a 0%, #2e0503 100%);
            border: 1px solid rgba(231, 109, 10, 0.25);
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
            overflow: hidden;
            transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), border-color 0.3s ease;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 30px 15px 24px;
        }

        .modern-player-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 16px 40px rgba(231, 109, 10, 0.35);
            border-color: #ff8c42;
        }

        .player-rank-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            font-size: 1.5rem;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
        }

        .modern-player-card.rank-1 {
            border-color: rgba(255, 215, 0, 0.5);
        }

        .modern-player-card.rank-1:hover {
            box-shadow: 0 16px 40px rgba(255, 215, 0, 0.4);
            border-color: #ffd700;
        }

        .player-profile-img {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #e76d0a;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
            transition: transform 0.4s ease, border-color 0.3s ease;
        }

        .modern-player-card:hover .player-profile-img {
            transform: scale(1.08);
            border-color: #ff8c42;
        }

        .card-content {
            padding: 16px 0 0;
            width: 100%;
            text-align: center;
        }

        .card-title {
            font-size: 1.3rem;
            margin: 0;
            font-weight: 700;
            color: #fff;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .player-points {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-top: 10px;
            padding: 4px 14px;
            border-radius: 999px;
            background: rgba(255, 140, 66, 0.15);
            color: #ffb066;
            font-size: 0.9rem;
            font-weight: 600;
        }

        @media (max-width: 768px) {
            .catalogue {
                grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
                gap: 20px;
            }
            .modern-player-card {
                padding: 22px 12px 18px;
            }
            .player-profile-img {
                width: 90px;
                height: 90px;
            }
            .card-title {
                font-size: 1.1rem;
            }
            .global-stat-tile {
                padding: 18px 24px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<main>
    <div class="content">

        <!-- 🔥 Zone des statistiques globales -->
        <section class="global-stats">
            <div class="global-stats-grid">
                <div class="global-stat-tile">
                    <span class="global-stat-icon">🎴</span>
                    <span id="totalCount" class="count global-stat-value" data-value="{{ totalCards }}">0</span>
                    <span class="global-stat-label">Cartes collectées</span>
                </div>
                <div class="global-stat-tile">
                    <span class="global-stat-icon">🍜</span>
                    <span id="animeCount" class="count global-stat-value" data-value="{{ animeCount }}">0</span>
                    <span class="global-stat-label">Cartes Anime</span>
                </div>
                <div class="global-stat-tile">
                    <span class="global-stat-icon">🎬</span>
                    <span id="filmCount" class="count global-stat-value" data-value="{{ filmCount }}">0</span>
                    <span class="global-stat-label">Cartes Film</span>
                </div>
            </div>
        </section>

        <div class="catalogue">
            {% for user in users %}
                <a href="{{ path('app_player_collection', {'id': user.id}) }}" class="player-card-link">
                    <div class="card special-card modern-player-card{% if loop.index <= 3 %} rank-{{ loop.index }}{% endif %}">
                        {% if loop.index <= 3 %}
                            <span class="player-rank-badge">{{ loop.index == 1 ? '🥇' : (loop.index == 2 ? '🥈' : '🥉') }}</span>
                        {% endif %}
                        {% if user.imageCollection %}
                            <img src="{{ asset(user.imageCollection) }}" alt="{{ user.pseudo }}" class="player-profile-img">
                        {% else %}
                            <img src="{{ asset('images/default-profile.png') }}" alt="{{ user.pseudo }}" class="player-profile-img">
                        {% endif %}
                        <div class="card-content">
                            <h2 class="card-title">{{ user.pseudo }}</h2>
                            <p class="player-points">⭐ {{ user.totalPoints }} points</p>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</main>


    {% block javascripts %}
        {{ parent() }}
        <script src="{{ asset('js/collection.js') }}"></script>
    {% endblock %}
{% endblock %}