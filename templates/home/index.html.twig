{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">

    <style>
        /* ============= CONTENEUR SUPERPOSÉ ============= */
        .hero-section {
            position: relative;
            width: 100%;
            height: 600px;
            overflow: hidden;
            margin: 0;
        }

        /* ============= BANNIÈRE EN ARRIÈRE-PLAN ============= */
        .animecardcollection {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 80%;
            z-index: 1;
        }

        .animecardcollection img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* ============= CARROUSEL EN AVANT ============= */
        .carousel-wrapper {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 90%;
            max-width: 1100px;
            z-index: 5; /* ← CARROUSEL SOUS LA NAVBAR */
            pointer-events: none;
        }

        .carousel-container {
            position: relative;
            overflow: hidden;
            border-radius: 20px;
            box-shadow: 0 15px 50px rgba(0,0,0,0.5);
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(3px);
            pointer-events: auto;
            z-index: 5; /* ← même */
        }

        .carousel-track {
            display: flex;
            transition: transform 0.8s ease-in-out;
        }

        .carousel-card {
            flex: 0 0 20%;
            padding: 10px;
            box-sizing: border-box;
        }

        .carousel-card img {
            width: 100%;
            height: 260px;
            object-fit: cover;
            border-radius: 14px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
            transition: transform 0.5s ease, box-shadow 0.5s ease;
        }

        .carousel-card img:hover {
            transform: scale(1.06);
            box-shadow: 0 12px 30px rgba(0,0,0,0.5);
        }

        /* Responsive */
        @media (max-width: 900px) {
            .carousel-card { flex: 0 0 33.33%; }
            .carousel-card img { height: 200px; }
            .hero-section { height: 500px; }
        }

        @media (max-width: 600px) {
            .carousel-card { flex: 0 0 50%; }
            .carousel-card img { height: 160px; }
            .hero-section { height: 450px; }
        }

        /* ============= HISTORIQUE DES DERNIERS DROPS ============= */
        .recent-drops-container {
            max-width: 800px;
            margin: 2rem auto 3rem;
            padding: 0 2rem;
        }

        .recent-drops-toggle {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(135deg, #f6f8ff 0%, #ffffff 100%);
            border: none;
            border-radius: 16px;
            padding: 16px 22px;
            font-size: 1.1rem;
            font-weight: 700;
            color: #2d3748;
            cursor: pointer;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            transition: box-shadow 0.2s ease;
        }

        .recent-drops-toggle:hover {
            box-shadow: 0 10px 34px rgba(0, 0, 0, 0.15);
        }

        .recent-drops-chevron {
            transition: transform 0.3s ease;
        }

        .recent-drops-toggle[aria-expanded="true"] .recent-drops-chevron {
            transform: rotate(180deg);
        }

        .recent-drops-panel {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease;
            background: #fff;
            border-radius: 0 0 16px 16px;
        }

        .recent-drops-panel.expanded {
            max-height: 700px;
        }

        .recent-drops-list {
            list-style: none;
            margin: 0;
            padding: 6px 22px 18px;
        }

        .recent-drop-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid #f0f2f5;
        }

        .recent-drop-item:last-child {
            border-bottom: none;
        }

        .recent-drop-item img {
            width: 42px;
            height: 42px;
            object-fit: cover;
            border-radius: 8px;
            border: 2px solid #fa9d11;
            flex-shrink: 0;
        }

        .recent-drop-info {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .recent-drop-name {
            font-weight: 700;
            color: #2d3748;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .recent-drop-meta {
            font-size: 0.85rem;
            color: #718096;
        }

        .recent-drop-time {
            font-size: 0.8rem;
            color: #a0aec0;
            white-space: nowrap;
        }

        .recent-drop-empty {
            text-align: center;
            color: #999;
            padding: 20px 0;
        }

        .recent-drop-type {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            padding: 1px 7px;
            border-radius: 999px;
            margin-right: 6px;
            color: #fff;
        }

        .recent-drop-type-anime {
            background: #4299e1;
        }

        .recent-drop-type-film {
            background: #9f7aea;
        }
    </style>
{% endblock %}

{% block body %}
<main>

    <!-- ============= SECTION SUPERPOSÉE : CARROUSEL + BANNIÈRE ============= -->
    <section class="hero-section">

        <!-- BANNIÈRE EN ARRIÈRE -->
        <div class="animecardcollection">
            <img src="{{ asset('images/Anime Cards Collection.jpg') }}" alt="Anime Cards Collection"/>
        </div>

        <!-- CARROUSEL EN AVANT (PAR-DESSUS) -->
        <div class="carousel-wrapper">
            <div class="carousel-container">
                <div class="carousel-track" id="carouselTrack">
                    {% if carouselImages is defined and carouselImages|length > 0 %}
                        {% for image in carouselImages %}
                            <div class="carousel-card">
                                <img src="{{ asset(image) }}" alt="Carte {{ loop.index }}">
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="carousel-card">
                            <img src="{{ asset('images/placeholder.png') }}" alt="Aucune image">
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

    </section>

    <!-- ============= TEASER VERS LA PAGE RÈGLES ============= -->
    <div class="obtain-cards-container">
        <h1 class="obtain-cards-title">Comment obtenir des cartes ?</h1>
        <p class="rules-intro">
            Events, sessions vocales, système de niveaux, drops aléatoires... découvrez toutes les façons de gagner des cartes
            ainsi que le détail de chaque type de tirage sur la page Infos.
        </p>
        <div style="text-align: center; margin-top: 1.5rem;">
            <a href="{{ path('app_rules') }}" class="pagination-btn" style="display: inline-flex;">
                Consulter les informations
            </a>
        </div>
    </div>

    <!-- ============= HISTORIQUE DES DERNIERS DROPS ============= -->
    <div class="recent-drops-container">
        <button type="button" class="recent-drops-toggle" id="recentDropsToggle" aria-expanded="false" aria-controls="recentDropsPanel">
            <span>🕓 Derniers drops</span>
            <span class="recent-drops-chevron">▾</span>
        </button>
        <div class="recent-drops-panel" id="recentDropsPanel">
            <ul class="recent-drops-list">
                {% for drop in recentDrops %}
                    <li class="recent-drop-item">
                        {% if drop.imagePath %}
                            <img src="{{ asset(drop.imagePath) }}" alt="{{ drop.nom }}">
                        {% endif %}
                        <div class="recent-drop-info">
                            <span class="recent-drop-name">{{ drop.nom }}</span>
                            <span class="recent-drop-meta">
                                <span class="recent-drop-type recent-drop-type-{{ drop.type|lower }}">{{ drop.type }}</span>
                                {{ drop.rarite }} · obtenue par <strong>{{ drop.pseudo }}</strong>
                            </span>
                        </div>
                        <span class="recent-drop-time">{{ drop.relative }}</span>
                    </li>
                {% else %}
                    <li class="recent-drop-empty">Aucun drop récent pour le moment.</li>
                {% endfor %}
            </ul>
        </div>
    </div>

</main>

<!-- ============= JAVASCRIPT CARROUSEL ============= -->
<script>
document.addEventListener("DOMContentLoaded", () => {
    const track = document.getElementById("carouselTrack");
    if (!track) return;

    const images = {{ carouselImages|json_encode|raw }};
    const total = images.length;
    const visible = 5;
    const delay = 4000;

    if (total <= visible) return;

    setInterval(() => {
        const first = track.firstElementChild;
        const cardWidth = first.offsetWidth + 20; // padding inclus

        track.style.transition = "transform 0.8s ease-in-out";
        track.style.transform = `translateX(-${cardWidth}px)`;

        setTimeout(() => {
            track.appendChild(first);
            track.style.transition = "none";
            track.style.transform = "translateX(0)";
        }, 850);
    }, delay);
});

document.addEventListener("DOMContentLoaded", () => {
    const dropsToggle = document.getElementById("recentDropsToggle");
    const dropsPanel = document.getElementById("recentDropsPanel");

    if (!dropsToggle || !dropsPanel) return;

    dropsToggle.addEventListener("click", () => {
        const expanded = dropsPanel.classList.toggle("expanded");
        dropsToggle.setAttribute("aria-expanded", expanded ? "true" : "false");
    });
});
</script>
{% endblock %}