{% extends 'base.html.twig' %}

{% block title %}Choisir un joueur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
{% endblock %}

{% block body %}
<main>
    <div class="admin-container users-list-page">
        <div class="dashboard-hero">
            <h1>👥 Choisir un joueur</h1>
        </div>

        <div class="user-grid">
            {% for user in users %}
                <div class="user-card">
                    <span class="user-card-name">{{ user.pseudo }}</span>
                    {% if type == 'anime' %}
                        <a href="{{ path('app_assign_anime_to_user', {'id': user.id}) }}" class="btn btn-primary">
                            Attribuer cartes
                        </a>
                    {% else %}
                        <a href="{{ path('app_assign_film_to_user', {'id': user.id}) }}" class="btn btn-primary">
                            Attribuer cartes
                        </a>
                    {% endif %}
                </div>
            {% else %}
                <p>Aucun joueur trouvé.</p>
            {% endfor %}
        </div>

        <div class="users-list-footer">
            <a href="{{ path('app_admin') }}" class="btn btn-secondary">← Retour au tableau de bord</a>
        </div>
    </div>
</main>
{% endblock %}