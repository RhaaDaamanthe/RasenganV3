{% extends 'base.html.twig' %}

{% block title %}Attribuer des cartes à {{ user.pseudo }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
    <style>
        .flash-message {
            padding: 1rem;
            margin-bottom: 1rem;
            border-radius: 8px;
            font-weight: bold;
        }

        .flash-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .card-assignment-form {
            padding: 12px 15px;
        }

        .quantity-input {
            width: 70px;
            padding: 7px 8px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            margin-right: 8px;
            font-size: 0.9rem;
        }

        .assign-btn {
            padding: 8px 16px;
            background: #ff8c00;
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .assign-btn:hover {
            background: #e07b00;
        }
    </style>
{% endblock %}

{% block body %}
<main>
    <div class="admin-container assign-cards-page">
        <div class="dashboard-hero">
            <h1>🎁 Attribuer des cartes {{ type == 'anime' ? 'd\'animé' : 'de film' }} à {{ user.pseudo }}</h1>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash-message flash-success">
                {{ message }}
            </div>
        {% endfor %}

        <!-- Barre de recherche -->
        <div class="search-filters-container">
            <form method="get" action="" class="search-form">
                <div class="search-input-wrapper">
                    <input
                        type="text"
                        name="search"
                        id="searchbar"
                        placeholder="Rechercher une carte..."
                        value="{{ search }}"
                    />
                    <button type="submit" class="search-btn">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- Pagination haut -->
        {% if totalPages > 1 %}
            <div class="pagination pagination-top">
                {% if currentPage > 1 %}
                    <a href="?page={{ currentPage - 1 }}{% if search %}&search={{ search }}{% endif %}" class="pagination-btn prev">← Précédent</a>
                {% endif %}

                <div class="pagination-numbers">
                    {% for i in 1..totalPages %}
                        {% if i == 1 or i == totalPages or (i >= currentPage - 2 and i <= currentPage + 2) %}
                            <a href="?page={{ i }}{% if search %}&search={{ search }}{% endif %}" 
                               class="page-number {% if i == currentPage %}active{% endif %}">
                                {{ i }}
                            </a>
                        {% elseif i == currentPage - 3 or i == currentPage + 3 %}
                            <span class="pagination-dots">...</span>
                        {% endif %}
                    {% endfor %}
                </div>

                {% if currentPage < totalPages %}
                    <a href="?page={{ currentPage + 1 }}{% if search %}&search={{ search }}{% endif %}" class="pagination-btn next">Suivant →</a>
                {% endif %}
            </div>
        {% endif %}

        <!-- Grille de cartes -->
        <div class="card-grid">
            {% for card in cards %}
                <div class="admin-card">
                    {% if card.imagePath %}
                        <img src="{{ asset(card.imagePath) }}" alt="{{ card.nom }}" class="card-image">
                    {% endif %}

                    <form method="post" class="card-assignment-form">
                        <input type="hidden" name="card_id" value="{{ card.id }}">
                        <input type="number" name="quantity" value="1" min="1" max="999" class="quantity-input">
                        <button type="submit" class="assign-btn">✓ Attribuer</button>
                    </form>
                </div>
            {% else %}
                <p>Aucune carte trouvée.</p>
            {% endfor %}
        </div>

        <!-- Pagination bas -->
        {% if totalPages > 1 %}
            <div class="pagination pagination-bottom">
                {% if currentPage > 1 %}
                    <a href="?page={{ currentPage - 1 }}{% if search %}&search={{ search }}{% endif %}" class="pagination-btn prev">← Précédent</a>
                {% endif %}

                <div class="pagination-numbers">
                    {% for i in 1..totalPages %}
                        {% if i == 1 or i == totalPages or (i >= currentPage - 2 and i <= currentPage + 2) %}
                            <a href="?page={{ i }}{% if search %}&search={{ search }}{% endif %}" 
                               class="page-number {% if i == currentPage %}active{% endif %}">
                                {{ i }}
                            </a>
                        {% elseif i == currentPage - 3 or i == currentPage + 3 %}
                            <span class="pagination-dots">...</span>
                        {% endif %}
                    {% endfor %}
                </div>

                {% if currentPage < totalPages %}
                    <a href="?page={{ currentPage + 1 }}{% if search %}&search={{ search }}{% endif %}" class="pagination-btn next">Suivant →</a>
                {% endif %}
            </div>
        {% endif %}

        <div class="media-list-page-footer">
            <a href="{{ path(type == 'anime' ? 'app_assign_anime_users' : 'app_assign_film_users') }}" class="btn btn-secondary">← Retour à la liste des joueurs</a>
        </div>
    </div>
</main>
{% endblock %}