{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
    <style>
        .flash-message {
            padding: 1rem;
            margin-bottom: 1rem;
            border-radius: 8px;
            font-weight: bold;
        }

        .flash-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .flash-error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
{% endblock %}

{% block body %}
<main>
    <div class="admin-container users-list-page">
        <div class="dashboard-hero">
            <h1>👤 Gestion des utilisateurs</h1>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash-message flash-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash-message flash-error">
                {{ message }}
            </div>
        {% endfor %}

        <div class="user-grid">
            {% for user in users %}
                <div class="user-card">
                    <span class="user-card-name">{{ user.pseudo }}</span>
                    <span class="user-card-email">{{ user.email }}</span>
                    <form method="post" action="{{ path('app_reset_user_password', {'id': user.id}) }}" class="user-card-form">
                        <input type="text" name="new_password" placeholder="Nouveau mot de passe" required class="user-card-input">
                        <button type="submit" class="btn btn-primary" onclick="return confirm('Réinitialiser le mot de passe de {{ user.pseudo }} ?')">
                            🔑 Réinitialiser
                        </button>
                    </form>
                </div>
            {% else %}
                <p>Aucun joueur trouvé.</p>
            {% endfor %}
        </div>

        <div class="users-list-footer">
            <a href="{{ path('app_admin') }}" class="btn btn-secondary">← Retour au tableau de bord</a>
        </div>
    </div>
</main>
{% endblock %}