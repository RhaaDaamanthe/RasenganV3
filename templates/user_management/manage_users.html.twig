{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
    <style>
        .flash-message {
            padding: 1rem;
            margin-bottom: 1rem;
            border-radius: 8px;
            font-weight: bold;
        }

        .flash-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .flash-error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .users-list-page .user-card-role {
            align-self: center;
            margin-top: -6px;
            padding: 2px 10px;
            border-radius: 999px;
            background: #eef2ff;
            color: #4338ca;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .users-list-page .user-card-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            padding-top: 10px;
            border-top: 1px solid #e5e7eb;
        }

        .users-list-page .user-card-actions .btn {
            width: 100%;
        }

        .users-list-page .user-card-self {
            padding-top: 10px;
            border-top: 1px solid #e5e7eb;
            font-size: 0.8rem;
            color: #9ca3af;
            text-align: center;
        }
    </style>
{% endblock %}

{% block body %}
<main>
    <div class="admin-container users-list-page">
        <div class="dashboard-hero">
            <h1>👤 Gestion des utilisateurs</h1>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash-message flash-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash-message flash-error">
                {{ message }}
            </div>
        {% endfor %}

        <div class="user-grid">
            {% for user in users %}
                <div class="user-card">
                    <span class="user-card-name">{{ user.pseudo }}</span>
                    <span class="user-card-email">{{ user.email }}</span>
                    {% if user.admin %}
                        <span class="user-card-role">🛡️ Administrateur</span>
                    {% endif %}
                    <form method="post" action="{{ path('app_set_user_discord_id', {'id': user.id}) }}" class="user-card-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('set-discord-id' ~ user.id) }}">
                        <input type="text" name="discord_id" value="{{ user.discordId }}" placeholder="ID Discord (17-20 chiffres)" inputmode="numeric" class="user-card-input">
                        <button type="submit" class="btn btn-secondary">
                            💬 Enregistrer l’ID Discord
                        </button>
                    </form>
                    <form method="post" action="{{ path('app_reset_user_password', {'id': user.id}) }}" class="user-card-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('reset-password' ~ user.id) }}">
                        <input type="text" name="new_password" placeholder="Nouveau mot de passe" required class="user-card-input">
                        <button type="submit" class="btn btn-primary" onclick="return confirm('Réinitialiser le mot de passe de {{ user.pseudo }} ?')">
                            🔑 Réinitialiser
                        </button>
                    </form>
                    {% if user != app.user %}
                        <div class="user-card-actions">
                            <form method="post" action="{{ path('app_toggle_user_admin', {'id': user.id}) }}" class="user-card-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle-admin' ~ user.id) }}">
                                {% if user.admin %}
                                    <button type="submit" class="btn btn-warning" onclick="return confirm('Retirer les droits d\'administration à {{ user.pseudo|e('js') }} ?')">
                                        ⬇️ Retirer admin
                                    </button>
                                {% else %}
                                    <button type="submit" class="btn btn-secondary" onclick="return confirm('Donner les droits d\'administration à {{ user.pseudo|e('js') }} ?')">
                                        🛡️ Passer admin
                                    </button>
                                {% endif %}
                            </form>
                            <form method="post" action="{{ path('app_delete_user', {'id': user.id}) }}" class="user-card-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-user' ~ user.id) }}">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Supprimer définitivement le compte de {{ user.pseudo|e('js') }} ?\n\nSa collection, ses wishlists, ses badges et tous les échanges où il apparaît seront effacés. Cette action est irréversible.')">
                                    🗑️ Supprimer
                                </button>
                            </form>
                        </div>
                    {% else %}
                        <span class="user-card-self">C'est votre compte</span>
                    {% endif %}
                </div>
            {% else %}
                <p>Aucun joueur trouvé.</p>
            {% endfor %}
        </div>

        <div class="users-list-footer">
            <a href="{{ path('app_admin') }}" class="btn btn-secondary">← Retour au tableau de bord</a>
        </div>
    </div>
</main>
{% endblock %}