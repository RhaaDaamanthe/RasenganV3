{% extends 'base.html.twig' %}

{% block title %}Retirer des cartes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
{% endblock %}

{% block body %}
<main>
    <div class="admin-container users-list-page">
        <div class="dashboard-hero">
            <h1>❌ Retirer des cartes aux joueurs</h1>
        </div>

        <div class="user-grid">
            {% for user in users %}
                <div class="user-card">
                    <span class="user-card-name">{{ user.pseudo }}</span>
                    <span class="user-card-email">{{ user.email }}</span>
                    <a href="{{ path('app_remove_user_cards', {'id': user.id}) }}" class="btn btn-danger">
                        Voir ses cartes
                    </a>
                </div>
            {% else %}
                <p>Aucun joueur trouvé.</p>
            {% endfor %}
        </div>

        <div class="users-list-footer">
            <a href="{{ path('app_admin') }}" class="btn btn-secondary">← Retour au tableau de bord</a>
        </div>
    </div>
</main>
{% endblock %}