{% extends 'base.html.twig' %}

{% block title %}Créer un jeu vidéo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
    <style>
        .simple-form-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .simple-form-header .simple-form-icon {
            font-size: 2.4em;
            display: block;
            margin-bottom: 6px;
        }

        .simple-form-header p {
            color: #777;
            margin: 6px 0 0;
            font-size: 0.95em;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="admin-container">
        <div class="card-form-wrapper">
            <div class="simple-form-header">
                <span class="simple-form-icon">🎮</span>
                <h1>Créer un nouveau jeu vidéo</h1>
                <p>Il pourra ensuite être associé à des cartes depuis la gestion des cartes de jeu vidéo.</p>
            </div>

            {{ form_start(form, {'attr': {'class': 'form-upload'}}) }}
                <div class="form-group">
                    {{ form_label(form.nom) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                </div>
                <button class="btn btn-primary" type="submit">Créer</button>
            {{ form_end(form) }}

            <div class="card-form-footer">
                <a href="{{ path('app_jeu_index') }}" class="btn btn-secondary">← Retour à la liste</a>
            </div>
        </div>
    </main>
{% endblock %}
