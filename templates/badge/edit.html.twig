{% extends 'base.html.twig' %}

{% block title %}Modifier {{ badge.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
    <style>
        .flash-message { padding: 1rem; margin-bottom: 1rem; border-radius: 8px; font-weight: bold; }
        .flash-success { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .flash-error { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    </style>
{% endblock %}

{% block body %}
    <main class="admin-container">
        <div class="card-form-wrapper">
            <h1>Modifier « {{ badge.name }} »</h1>

            {% for message in app.flashes('success') %}
                <div class="flash-message flash-success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="flash-message flash-error">{{ message }}</div>
            {% endfor %}

            {% include 'badge/_form.html.twig' with {form: form, badge: badge, button_label: 'Enregistrer'} %}

            <div class="card-form-footer">
                <a href="{{ path('app_badge_index') }}" class="btn btn-secondary">← Retour à la liste</a>
            </div>
        </div>
    </main>
{% endblock %}
