{% extends 'base.html.twig' %}

{% block title %}Gérer les badges{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
    <style>
        .flash-message { padding: 1rem; margin-bottom: 1rem; border-radius: 8px; font-weight: bold; }
        .flash-success { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .flash-error { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    </style>
{% endblock %}

{% block body %}
<main>
    <div class="admin-container">
        <div class="dashboard-hero">
            <h1>🏅 Gérer les badges</h1>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash-message flash-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash-message flash-error">{{ message }}</div>
        {% endfor %}

        <div class="actions-header">
            <a href="{{ path('app_badge_new') }}" class="btn btn-action">+ Créer un badge</a>
        </div>

        <section class="badge-admin-section">
            <h2 class="badge-admin-section-title">🎖️ Collectionneur <span class="badge-admin-section-count">{{ collectorBadges|length }}</span></h2>
            <div class="card-grid">
                {% for badge in collectorBadges %}
                    {% include 'badge/_card.html.twig' with {badge: badge} %}
                {% else %}
                    <p>Aucun badge Collectionneur.</p>
                {% endfor %}
            </div>
        </section>

        <section class="badge-admin-section">
            <h2 class="badge-admin-section-title">📅 Ancienneté <span class="badge-admin-section-count">{{ seniorityBadges|length }}</span></h2>
            <div class="card-grid">
                {% for badge in seniorityBadges %}
                    {% include 'badge/_card.html.twig' with {badge: badge} %}
                {% else %}
                    <p>Aucun badge Ancienneté.</p>
                {% endfor %}
            </div>
        </section>

        <section class="badge-admin-section">
            <h2 class="badge-admin-section-title">🎉 Événements <span class="badge-admin-section-count">{{ eventBadges|length }}</span></h2>
            <div class="card-grid">
                {% for badge in eventBadges %}
                    {% include 'badge/_card.html.twig' with {badge: badge} %}
                {% else %}
                    <p>Aucun badge événement.</p>
                {% endfor %}
            </div>
        </section>

        <div class="media-list-page-footer">
            <a href="{{ path('app_admin') }}" class="btn btn-secondary">← Retour au tableau de bord</a>
        </div>
    </div>
</main>
{% endblock %}
