{% extends 'base.html.twig' %}

{% block title %}Créer un badge{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}" />
{% endblock %}

{% block body %}
    <main class="admin-container">
        <div class="card-form-wrapper">
            <h1>Créer un badge</h1>

            {% include 'badge/_form.html.twig' with {form: form, button_label: 'Créer'} %}

            <div class="card-form-footer">
                <a href="{{ path('app_admin') }}" class="btn btn-secondary">← Retour au tableau de bord</a>
            </div>
        </div>
    </main>
{% endblock %}
