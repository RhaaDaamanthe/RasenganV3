{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('css/profil.css') }}" />
{% endblock %}

{% block body %}
    <main class="profile-container">
        <div class="profile-hero"></div>

        <!-- Avatar -->
        {% if user.imageCollection %}
            <img src="{{ asset(user.imageCollection) }}" alt="Avatar" class="profile-avatar">
        {% else %}
            <div class="profile-avatar profile-avatar-placeholder">{{ user.pseudo|first|upper }}</div>
        {% endif %}

        <!-- Titre -->
        <h1>Bienvenue sur ton profil, {{ user.pseudo }}</h1>
        <p>Gère tes informations ici et personnalise ta carte de profil.</p>

        <a href="{{ path('app_profile_settings') }}" class="btn-edit-profile">
            Modifier mes paramètres
        </a>

        <a href="{{ path('app_trade_list') }}" class="btn-edit-profile" style="margin-top: 12px;">
            🔁 Mes échanges
            {% if pendingTradesCount > 0 %}
                <span style="display:inline-block; margin-left:8px; background:#e76d0a; color:#fff; border-radius:999px; padding:2px 9px; font-size:0.8rem; font-weight:700;">{{ pendingTradesCount }}</span>
            {% endif %}
        </a>

        <!-- Stats rapides -->
        <div class="profile-stats">
            <div class="stat-item stat-cards">
                <span class="stat-icon">🎴</span>
                <span class="stat-number">{{ user.getTotalCardsCount }}</span>
                <span class="stat-label">Cartes</span>
            </div>
            <div class="stat-item stat-points">
                <span class="stat-icon">⭐</span>
                <span class="stat-number">{{ user.getTotalPoints }}</span>
                <span class="stat-label">Points</span>
            </div>
        </div>

        {% include 'badges/_showcase.html.twig' with {showcase: badgeShowcase, pseudo: user.pseudo} %}
    </main>
{% endblock %}